// Cloudflare Worker that runs the Next.js site (same setup as Gathered).
// The public address stays https://throvic.pages.dev: the "throvic" Pages project (cloudflare-pages/)
// serves static files and hands every other request to this Worker through a service binding named SITE.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "throvic-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Only reachable through the Pages project, so the site never appears under a second address.
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "keep_names": false,

  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "throvic-site" }],

  // Page cache, tag cache and the graph cache (src/lib/cache.ts) share one D1 database.
  // Before the first deploy: `npx wrangler d1 create throvic-db` and paste its database_id here.
  // Local dev and preview use a local copy, so the placeholder id works on this machine.
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "throvic-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],

  // Secrets (GROQ_API_KEY) are set with `npx wrangler secret put GROQ_API_KEY`, never written here.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://throvic.pages.dev"
  },

  "observability": { "enabled": true }
}
