# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run cf:preview`.

# Public URL of the site (canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://throvic.pages.dev

# AI graph generation (server-only, never sent to the browser). https://console.groq.com/keys
# When empty, graphs are built from Wikipedia's article links instead (works, but less rich).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Formspree form ID for the feedback form on the home page.
NEXT_PUBLIC_FORMSPREE_ID=mzdyypdp

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = disabled.
NEXT_PUBLIC_GA_ID=
# Search Console / Bing HTML-tag verification codes. Empty = not added.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
